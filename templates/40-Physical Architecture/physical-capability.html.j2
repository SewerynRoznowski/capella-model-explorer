{%
  from 'common_macros.html.j2' import
  description,
  display_traceability,
  linked_name,
  linked_name_with_icon,
  render_artifacts_section,
  render_capability_relations,
  render_states_table,
  render_constraints,
  render_node_behavior_function_involvement,
  render_related_diagrams,
  render_reqs_by_type,
  show_other_attributes
%}

<h1>{{ object.name }}</h1>
{{ description(object) | safe }}

<b>Pre-condition</b>:
{% if object.precondition %}
  <p>{{ object.precondition.specification['capella:linkedText']|safe }}</p>
{% else %}
  <p style="color:red">No pre-condition defined</p>
{% endif %}

<b>Post-condition</b>:
{% if object.postcondition %}
  <p>{{ object.postcondition.specification['capella:linkedText']|safe }}</p>
{% else %}
  <p style="color:red">No post-condition defined</p>
{% endif %}

{{ render_capability_relations(object) | safe }}

{% if object.available_in_states %}
  <h2>Availability</h2>
  {{
    render_states_table(
      object.available_in_states,
      "The capability " ~ object.name ~ " is only available while the system is in the following states or modes:"
    ) | safe
  }}
{% endif %}


<h2>Functional Requirements</h2>
{{ render_node_behavior_function_involvement(object) | safe }}
{%- set related_chains = (object.involved_chains + object.owned_chains) | unique(attribute="uuid") | list -%}
{%- if related_chains -%}
  <h2>Related Functional Chains</h2>
  <p>
    The following functional chains are related to the Capability
    {{ object.name }}:
  </p>
  <ul>
    {%- for chain in related_chains -%}
      <li>{{ linked_name_with_icon(chain) | safe }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{{ render_related_diagrams(object) | safe }}

{{ render_constraints(object) | safe }}

{% if object.requirements %}
  <h2>Linked Requirement objects</h2>
  {% set types = model.search("RequirementType") | map(attribute="long_name") | unique | list %}
  {{ render_reqs_by_type(object.requirements, types) | safe }}
{% endif %}

{{ display_traceability(object)| safe }}

<h2>Other properties of "{{ object.name }}"</h2>

{%-
  set excluded = [
    "available_in_states",
    "constraints",
    "context_diagram",
    "data_flow_view",
    "description",
    "diagrams",
    "extended_by",
    "extends",
    "generalized_by",
    "generalizes",
    "included_by",
    "includes",
    "involved_chains",
    "involved_components",
    "involved_functions",
    "name",
    "owned_chains",
    "parent",
    "postcondition",
    "precondition",
    "realizing_capabilities",
    "requirements",
    "visible_on_diagrams",
    "xtype",
  ]
-%}
{{ show_other_attributes(object, excluded=excluded) | safe }}

{#
  Supporting documentation bound to this element in
  artifacts/index.yaml - a wiring diagram, a datasheet, a 3D model, an
  analysis notebook. Renders nothing at all when no artifact is bound,
  so it costs an unbound element neither a heading nor a placeholder.
#}
{{ render_artifacts_section(object, model) | safe }}
