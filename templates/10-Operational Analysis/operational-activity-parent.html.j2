{#- A parent activity: the context diagram would show it as a lone box,
    because the work and most of the interactions sit in its children.
    The boundary and hierarchy views take its place. -#}
{{ describe_parent_activity_intro(object) | safe }}
{{ describe_decomposition(object) | safe }}
{{ describe_activity_io(object) | safe }}
{{ describe_activity_tail(object) | safe }}

<h2>Other properties of "{{ object.name }}"</h2>
{%-
  set excluded = [
    "available_in_states",
    "activities",
    "boundary_view",
    "context_diagram",
    "functions",
    "hierarchy_view",
    "description",
    "inputs",
    "name",
    "outputs",
    "owner",
    "owning_entity",
    "parent",
    "realization_view",
    "realizing_system_functions",
    "related_exchanges",
    "requirements",
    "xtype",
  ]
-%}
{{ show_other_attributes(object, excluded=excluded) | safe }}

{#
  Supporting documentation bound to this element in
  artifacts/index.yaml - a wiring diagram, a datasheet, a 3D model, an
  analysis notebook. Renders nothing at all when no artifact is bound,
  so it costs an unbound element neither a heading nor a placeholder.
#}
{{ render_artifacts_section(object, model) | safe }}
