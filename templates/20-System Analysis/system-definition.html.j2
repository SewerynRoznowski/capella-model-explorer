{%
  from 'common_macros.html.j2' import
  description,
  display_property_label,
  linked_name_with_icon,
  render_allocated_functions,
  render_capability_section,
  render_constraints_table,
  render_exchange_items_catalog,
  render_involved_components_section,
  render_interfaces_section,
  render_pvmt_table,
  render_reqs_by_type,
  show_other_attributes
%}
{% set object = model.sa.root_component %}

<h1>System Definition</h1>

<h2>1 Document Purpose</h2>
<p>The purpose of this document is the following:</p>
<ul>
  <li>Definition of the purpose of the system, system capabilities</li>
  <li>
    System description, including the following aspects
    <ul>
      <li>Definition of the system functions</li>
      <li>The system boundary and the actors interacting with the system</li>
      <li>Definition of the interfaces between the system and the actors</li>
    </ul>
  </li>
  <li>Application conditions and limitations</li>
  <li>Safety measures</li>
  <li>Known limitations and assumptions</li>
</ul>

<p>
  This document is intended to serve the needs of multiple audiences including,
  but not limited to:
</p>
<ul>
  <li>All readers, to describe the System under Consideration</li>
  <li>Safety organisation, to provide the input document for RAMS analysis</li>
  <li>
    System architects, to provide foundations for architecture and design
    activities
  </li>
  <li>IVV, to provide basic understanding about the system</li>
</ul>

<h2>2 System Description</h2>
{{ description(object) | safe }}

<h2>3 System Capabilities</h2>
{% set capabilities = model.sa.all_capabilities %}
{{ render_capability_section(object, capabilities) | safe }}

<h2>4 System Boundary</h2>
<p>
  The figure below provides an overview of the system boundary and depicts all
  the Actors that the <i>{{ object.name }}</i> interacts with.
</p>
{{ render_diagram(object, "context_diagram", display_derived_interfaces=True) }}
{% set actors = model.sa.all_actors %}
{% set caps = model.sa.all_capabilities %}
{{ render_involved_components_section(object, actors, caps) | safe }}

<h2>5 System Functions</h2>
{{ render_allocated_functions(object) | safe }}

<h2>6 Functional Chains</h2>
{% for chain in model.sa.all_functional_chains %}
  <h3>{{ linked_name_with_icon(chain) }}</h3>
  {{ chain.context_diagram }}
  <p>{{ description(chain) | safe }}</p>
{% endfor %}

<h2>7 System Interfaces</h2>
{% set interfaces = object.related_exchanges %}
{% set exchange_items_catalog = [] %}
{{ render_interfaces_section(object, interfaces, exchange_items_catalog) | safe }}

{% if object.requirements %}
  <h2>8 Requirements</h2>
  {% set types = model.search("RequirementType") | map(attribute="long_name") | unique | list %}
  {{ render_reqs_by_type(object.requirements, types) | safe }}
{% endif %}

<h2>9 Constraints</h2>
{{ render_constraints_table(find_related_constraints(model, object)) | safe }}

<h2>10 Property Values (PVMT)</h2>
{{ render_pvmt_table(object, model) | safe }}

{% if exchange_items_catalog %}
  <h2>Appendix A: Exchange Items Catalogue</h2>
  {{ render_exchange_items_catalog(exchange_items_catalog) | safe }}
{% endif %}

<h2>Appendix B: 3D Model Rendering Test (Experimental)</h2>
<p>
  Proof-of-concept only: a plain box primitive, rendered client-side, to
  gauge whether a report page could show real 3D component geometry -
  e.g. via a future pipeline that exports a simplified mesh from a CAD
  tool (such as Fusion) and converts it to a web-friendly format. Drag to
  orbit, scroll to zoom. The lines mark the origin (red = X, green = Y,
  blue = Z).
</p>
<div
  id="threejs-box-demo"
  style="position: relative; width: 100%; max-width: 480px; height: 320px; border: 1px solid #ccc; border-radius: 4px; cursor: grab;"
></div>
<script type="module">
  import * as THREE from "https://unpkg.com/three@0.160.0/build/three.module.js";

  const container = document.getElementById("threejs-box-demo");
  if (container && !container.dataset.initialized) {
    container.dataset.initialized = "true";

    const size = { width: 0.2, height: 0.1, depth: 0.1 };

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf2f2f2);

    const camera = new THREE.PerspectiveCamera(
      45,
      container.clientWidth / container.clientHeight,
      0.01,
      10,
    );
    camera.position.set(0.35, 0.28, 0.42);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
    dirLight.position.set(3, 5, 2);
    scene.add(dirLight);

    const box = new THREE.Mesh(
      new THREE.BoxGeometry(size.width, size.height, size.depth),
      new THREE.MeshStandardMaterial({ color: 0x3b6ea5 }),
    );
    scene.add(box);

    // Origin marker: red/green/blue lines along X/Y/Z from (0, 0, 0).
    // Parented to the box (not the scene) so it rotates along with it.
    box.add(new THREE.AxesHelper(0.15));

    const tooltip = document.createElement("div");
    tooltip.textContent = `${size.width} × ${size.height} × ${size.depth} m`;
    tooltip.style.position = "absolute";
    tooltip.style.pointerEvents = "none";
    tooltip.style.display = "none";
    tooltip.style.background = "rgba(0, 0, 0, 0.75)";
    tooltip.style.color = "#fff";
    tooltip.style.font = "12px sans-serif";
    tooltip.style.padding = "2px 6px";
    tooltip.style.borderRadius = "4px";
    tooltip.style.whiteSpace = "nowrap";
    container.appendChild(tooltip);

    // Hand-rolled drag-to-rotate / scroll-to-zoom, instead of the
    // OrbitControls addon: that addon internally imports the bare
    // specifier "three", which needs an import map, and import maps
    // aren't picked up when the script is injected dynamically (e.g.
    // via an htmx swap) rather than present in the page's initial parse.
    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    container.addEventListener("pointerdown", (event) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      container.style.cursor = "grabbing";
      tooltip.style.display = "none";
    });
    window.addEventListener("pointerup", () => {
      dragging = false;
      container.style.cursor = "grab";
    });
    window.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      box.rotation.y += dx * 0.01;
      box.rotation.x += dy * 0.01;
    });
    container.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        const distance = camera.position.length();
        const next = Math.min(
          0.9,
          Math.max(0.15, distance + event.deltaY * 0.0006),
        );
        camera.position.setLength(next);
      },
      { passive: false },
    );

    // Hover: raycast against the box to show its dimensions next to
    // the cursor, only while not dragging (dragging already hides it).
    const raycaster = new THREE.Raycaster();
    const pointerNdc = new THREE.Vector2();

    container.addEventListener("pointermove", (event) => {
      if (dragging) return;
      const rect = container.getBoundingClientRect();
      pointerNdc.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointerNdc.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointerNdc, camera);
      const hit = raycaster.intersectObject(box).length > 0;

      tooltip.style.display = hit ? "block" : "none";
      tooltip.style.left = `${event.clientX - rect.left + 12}px`;
      tooltip.style.top = `${event.clientY - rect.top + 12}px`;
      container.style.cursor = hit ? "pointer" : "grab";
    });
    container.addEventListener("pointerleave", () => {
      tooltip.style.display = "none";
    });

    function animate() {
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }
    animate();
  }
</script>
