{% from "common_macros.html.j2" import description, display_traceability, render_artifacts_section, render_interface_exchanges, show_other_attributes %}

{% if object.name %}
  <h1>
    {{ object.name }}
    <span style="font-size: 60%">({{ object.__class__.__name__ }})</span>
  </h1>
{% else %}
  <h1>Unnamed ({{ object.__class__.__name__ }})</h1>
{% endif %}

{#
  What the interface is for, in the modeller's own words. This used to be
  a sentence assembled from the allocated exchanges - who provides what
  to whom - but the Functional interactions table below now says exactly
  that, in more detail and per exchange.
#}
{{ description(object) | safe }}

<h2>Functional context</h2>
<p>
  The functional interactions between interface partners via {{ object.name }}
  are summarized by the diagram below:
</p>
{{ render_diagram(object, "context_diagram") }}

<h2>Functional interactions</h2>
<p>
  {{ object.name }} may be used for the following functional interactions, and
  for the Exchange Items each one carries:
</p>
{{ render_interface_exchanges(object) | safe }}

{{ display_traceability(object) | safe }}

<h2>Other object attributes</h2>

{%-
  set excluded = [
    "allocated_functional_exchanges",
    "context_diagram",
    "exchange_items",
    "description",
    "name",
    "parent",
    "realized_component_exchanges",
    "realizing_component_exchanges",
    "xtype",
    "iter_ancestors",
    "functional_exchange_allocations"
  ]
-%}
{{ show_other_attributes(object, excluded=excluded) | safe }}

{#
  Supporting documentation bound to this element in
  artifacts/index.yaml - a wiring diagram, a datasheet, a 3D model, an
  analysis notebook. Renders nothing at all when no artifact is bound,
  so it costs an unbound element neither a heading nor a placeholder.
#}
{{ render_artifacts_section(object, model) | safe }}
