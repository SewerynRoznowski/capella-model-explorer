{% from "common_macros.html.j2" import render_artifacts_section, render_constraints_section, show_other_attributes %}
{% from 'functional.html.j2' import describe_parent_function %}

{#- describe_parent_function already renders a Requirements section
    of its own, so this template adds only the constraints. -#}
{{ describe_parent_function(object) | safe }}

{{ render_constraints_section(object, model) | safe }}

<h2>Other properties of "{{ object.name }}"</h2>
{%-
  set excluded = [
    "applied_property_value_groups",
    "available_in_states",
    "boundary_view",
    "context_diagram",
    "description",
    "functions",
    "hierarchy_view",
    "inputs",
    "involved_in",
    "name",
    "outputs",
    "owner",
    "parent",
    "property_value_groups",
    "realization_view",
    "realized_functions",
    "realized_operational_activities",
    "realizing_functions",
    "realizing_logical_functions",
    "related_exchanges",
    "uuid",
    "validate",
    "xtype",
    "iter_ancestors",
    "exchanges"
  ]
-%}
{{ show_other_attributes(object, excluded=excluded) | safe }}

{#
  Supporting documentation bound to this element in
  artifacts/index.yaml - a wiring diagram, a datasheet, a 3D model, an
  analysis notebook. Renders nothing at all when no artifact is bound,
  so it costs an unbound element neither a heading nor a placeholder.
#}
{{ render_artifacts_section(object, model) | safe }}
